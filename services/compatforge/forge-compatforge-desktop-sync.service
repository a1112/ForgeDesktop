[Unit]
Description=Synchronize CompatForge application launchers
After=compatforge.service
Requisite=compatforge.service
PartOf=graphical-session.target
ConditionPathExists=/usr/bin/compatforge-cli

[Service]
Type=oneshot
ExecStart=/usr/libexec/forge-desktop/compatforge-desktop-sync
TimeoutStartSec=90
NoNewPrivileges=true
